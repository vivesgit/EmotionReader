# Copia este archivo a .env y rellena tus valores: cp .env.example .env
# config.py es el único módulo que lee estas variables.

# --- OpenAI ---
# Obligatoria para preguntar. Nunca la escribas en el código ni la subas a git.
OPENAI_API_KEY=
# Último modelo Realtime disponible.
GPT_LIVE_MODEL=gpt-realtime-2.1
# Voz de la respuesta: marin | cedar | alloy | ash | ballad | coral | echo | sage | shimmer | verse
GPT_LIVE_VOICE=marin
# Idioma de la respuesta hablada (ISO-639-1).
RESPONSE_LANGUAGE=es
# Tiempo máximo de espera por petición, en segundos.
REQUEST_TIMEOUT_SECONDS=30

# --- Emociones / cámara ---
# Segundos de emociones que se agregan al pulsar "Preguntar".
EMOTION_WINDOW_SECONDS=5
# Índice de la webcam (0 = cámara integrada).
CAMERA_INDEX=0
